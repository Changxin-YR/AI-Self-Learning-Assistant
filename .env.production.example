APP_ENV=production
DEV_MODE=false
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=https://your-h5-domain.example
WECHAT_APP_ID=wx_replace_with_real_appid
WECHAT_APP_SECRET=replace-with-real-appsecret
WECHAT_API_BASE_URL=https://api.your-domain.example/api/v1
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://your-llm-gateway.example/v1
LLM_API_KEY=replace-with-real-key
LLM_MODEL=replace-with-real-model
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://your-embedding-gateway.example/v1
EMBEDDING_API_KEY=replace-with-real-key
EMBEDDING_MODEL=replace-with-real-model
CONTENT_SAFETY_PROVIDER=external
