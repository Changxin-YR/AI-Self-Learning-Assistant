page { background:#F6F7FB; color:#111318; font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif; }
.page { padding:40rpx 32rpx 160rpx; }
.eyebrow { color:#8b91a1; font-size:20rpx; letter-spacing:2rpx; margin-bottom:14rpx; }
h1 { font-size:58rpx; line-height:1.12; margin:0 0 36rpx; font-weight:600; } h2 { font-size:38rpx; margin:0 0 12rpx; } h3 { font-size:30rpx; margin:0; } .muted { color:#7f8695; font-size:24rpx; }
.button { border-radius:18rpx; font-size:26rpx; font-weight:600; padding:22rpx 28rpx; line-height:1; } .button::after { border:0; } .primary { background:#5B5FF6; color:#fff; } .ghost { background:#fff; color:#5B5FF6; border:1rpx solid #dfe1ff; } .link { color:#5B5FF6; background:none; padding:0; font-size:24rpx; } .danger { color:#d94b5a; }
.focus-card { background:#111318; color:#fff; border-radius:32rpx; padding:32rpx; margin-bottom:44rpx; } .focus-line { display:flex; justify-content:space-between; align-items:center; } .progress { height:10rpx; background:#343743; border-radius:10rpx; margin:28rpx 0; overflow:hidden; } .progress > view { height:100%; background:#2DBE8C; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:36rpx 0 20rpx; } .quick-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; } .quick { text-align:left; background:#fff; border:1rpx solid #e8eaf0; border-radius:24rpx; padding:26rpx; } .quick .icon { color:#5B5FF6; font-size:34rpx; margin-bottom:16rpx; display:block; } .quick text { display:block; font-weight:600; font-size:28rpx; } .quick .muted { font-size:21rpx; margin-top:8rpx; font-weight:400; }
.card { display:flex; align-items:center; gap:20rpx; background:#fff; border:1rpx solid #e8eaf0; border-radius:24rpx; padding:24rpx; margin-bottom:16rpx; } .icon-box { width:76rpx; height:76rpx; border-radius:20rpx; display:flex; align-items:center; justify-content:center; background:#eeefff; font-size:40rpx; } .card-main { flex:1; } .card-main text { display:block; } .card-main .muted { margin-top:8rpx; } .arrow { color:#b2b7c5; font-size:30rpx; }
.empty { text-align:center; color:#7f8695; background:#fff; border:1rpx dashed #d8dce6; border-radius:24rpx; padding:64rpx 24rpx; font-size:24rpx; } .empty .button { margin-top:20rpx; }
.detail { background:#fff; border:1rpx solid #e8eaf0; border-radius:24rpx; padding:26rpx; margin-top:28rpx; } .detail-actions { display:flex; gap:14rpx; margin:22rpx 0; } .detail-actions .button { flex:1; } .doc-row,.task-row { display:flex; align-items:center; gap:18rpx; padding:22rpx 0; border-bottom:1rpx solid #f0f1f4; } .doc-row:last-child,.task-row:last-child { border-bottom:0; } .doc-row .main,.task-row .main { flex:1; } .doc-row text,.task-row text { display:block; font-size:25rpx; } .doc-row .muted,.task-row .muted { font-size:21rpx; margin-top:6rpx; } .status { font-size:21rpx; color:#2DBE8C; }
.plan { background:#111318; color:#fff; border-radius:32rpx; padding:30rpx; margin-bottom:30rpx; } .plan .muted { color:#b4b8c5; } .task-row.done .main { color:#9ea2ac; text-decoration:line-through; } .check { width:42rpx; height:42rpx; border-radius:14rpx; border:2rpx solid #d5d8e0; display:flex; align-items:center; justify-content:center; color:transparent; } .task-row.done .check { color:#fff; background:#2DBE8C; border-color:#2DBE8C; }
.stats { display:flex; background:#fff; border:1rpx solid #e8eaf0; border-radius:24rpx; margin-bottom:26rpx; } .stats .stat { flex:1; padding:28rpx 18rpx; border-right:1rpx solid #e8eaf0; } .stats .stat:last-child { border:0; } .stat strong,.stat text { display:block; } .stat strong { font-size:38rpx; } .stat text { color:#7f8695; font-size:21rpx; margin-top:6rpx; }
.modal-mask { position:fixed; inset:0; background:rgba(17,19,24,.38); display:flex; align-items:center; justify-content:center; z-index:10; } .modal { width:620rpx; max-height:86vh; background:#fff; border-radius:28rpx; padding:30rpx; box-sizing:border-box; } .modal input,.modal textarea { border:1rpx solid #e5e7ed; border-radius:16rpx; padding:22rpx; margin:18rpx 0 28rpx; width:100%; box-sizing:border-box; font-size:26rpx; }
