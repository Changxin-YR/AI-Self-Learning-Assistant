page { background:#f7f8fa; color:#171717; font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif; }
.page { padding:36rpx 32rpx 140rpx; }
.eyebrow { color:#9296a2; font-size:20rpx; letter-spacing:3rpx; margin-bottom:14rpx; }
h1 { font-size:58rpx; line-height:1.12; margin:0 0 36rpx; font-weight:600; } h2 { font-size:38rpx; margin:0 0 12rpx; } h3 { font-size:30rpx; margin:0; } .muted { color:#9296a2; font-size:24rpx; }
.button { border-radius:16rpx; font-size:26rpx; font-weight:600; padding:20rpx 26rpx; line-height:1; } .primary { background:#5b6cff; color:#fff; } .ghost { background:#fff; color:#5b6cff; border:1rpx solid #dce0ff; } .link { color:#5b6cff; background:none; padding:0; font-size:24rpx; }
.focus-card { background:#171717; color:#fff; border-radius:24rpx; padding:30rpx; margin-bottom:42rpx; } .focus-line { display:flex; justify-content:space-between; align-items:center; } .progress { height:8rpx; background:#363636; border-radius:8rpx; margin:28rpx 0; overflow:hidden; } .progress > view { height:100%; background:#7481ff; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:34rpx 0 18rpx; } .quick-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; } .quick { text-align:left; background:#fff; border:1rpx solid #e5e7ed; border-radius:20rpx; padding:24rpx; } .quick .icon { color:#5b6cff; font-size:34rpx; margin-bottom:16rpx; display:block; } .quick text { display:block; font-weight:600; font-size:28rpx; } .quick .muted { font-size:21rpx; margin-top:8rpx; }
.card { display:flex; align-items:center; gap:20rpx; background:#fff; border:1rpx solid #e5e7ed; border-radius:20rpx; padding:24rpx; margin-bottom:14rpx; } .icon-box { width:76rpx; height:76rpx; border-radius:18rpx; display:flex; align-items:center; justify-content:center; background:#f0f1ff; font-size:40rpx; } .card-main { flex:1; } .card-main text { display:block; } .card-main .muted { margin-top:8rpx; } .arrow { color:#b4b7c1; font-size:30rpx; }
.empty { text-align:center; color:#9296a2; background:#fff; border:1rpx dashed #d9dce4; border-radius:20rpx; padding:60rpx 24rpx; font-size:24rpx; } .empty .button { margin-top:20rpx; }
.detail { background:#fff; border-radius:20rpx; padding:24rpx; margin-top:28rpx; } .detail-actions { display:flex; gap:14rpx; margin:22rpx 0; } .detail-actions .button { flex:1; } .doc-row,.task-row { display:flex; align-items:center; gap:18rpx; padding:22rpx 0; border-bottom:1rpx solid #f0f1f4; } .doc-row:last-child,.task-row:last-child { border-bottom:0; } .doc-row .main,.task-row .main { flex:1; } .doc-row text,.task-row text { display:block; font-size:25rpx; } .doc-row .muted,.task-row .muted { font-size:21rpx; margin-top:6rpx; } .status { font-size:21rpx; color:#2da96f; }
.plan { background:#171717; color:#fff; border-radius:24rpx; padding:28rpx; margin-bottom:30rpx; } .plan .muted { color:#a4a7b4; } .task-row.done .main { color:#9ea2ac; text-decoration:line-through; } .check { width:42rpx; height:42rpx; border-radius:12rpx; border:2rpx solid #d5d8e0; display:flex; align-items:center; justify-content:center; color:transparent; } .task-row.done .check { color:#fff; background:#32b47a; border-color:#32b47a; }
.stats { display:flex; background:#fff; border:1rpx solid #e5e7ed; border-radius:20rpx; margin-bottom:24rpx; } .stats .stat { flex:1; padding:28rpx 18rpx; border-right:1rpx solid #e5e7ed; } .stats .stat:last-child { border:0; } .stat strong,.stat text { display:block; } .stat strong { font-size:38rpx; } .stat text { color:#9296a2; font-size:21rpx; margin-top:6rpx; }
.modal-mask { position:fixed; inset:0; background:rgba(23,23,23,.35); display:flex; align-items:center; justify-content:center; z-index:10; } .modal { width:620rpx; background:#fff; border-radius:24rpx; padding:30rpx; } .modal input { border:1rpx solid #e5e7ed; border-radius:14rpx; padding:22rpx; margin:18rpx 0 28rpx; width:100%; box-sizing:border-box; font-size:26rpx; }
