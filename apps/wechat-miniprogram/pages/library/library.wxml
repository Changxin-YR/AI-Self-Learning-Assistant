<view class="page">
  <view class="section-head" style="margin-top:0"><view><view class="eyebrow">YOUR MATERIALS</view><text style="font-size:56rpx;font-weight:600">知识库</text></view><button class="button primary" bindtap="openCreate">＋ 新建</button></view>
  <input class="search-input" placeholder="搜索知识库" value="{{query}}" bindinput="inputSearch" />
  <view wx:if="{{loading}}" class="empty">正在加载知识库…</view><view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="button primary" bindtap="retry">重新加载</button></view>
  <view wx:else><view wx:for="{{visibleLibraries}}" wx:key="id" class="card" data-kb="{{item}}" bindtap="select"><view class="icon-box">{{item.icon}}</view><view class="card-main"><text style="font-weight:600">{{item.name}}</text><text class="muted">{{item.category || '其他'}} · {{item.document_count}} 份资料 · {{item.chunk_count}} 个片段</text></view><text class="status">{{item.status == 'ARCHIVED' ? '已归档' : ''}}</text><text class="arrow">›</text></view><view wx:if="{{!visibleLibraries.length}}" class="empty"><text>{{query ? '没有匹配的知识库' : '还没有知识库'}}</text><button wx:if="{{!query}}" class="button primary" bindtap="openCreate">创建第一个知识库</button></view></view>
  <view wx:if="{{selected}}" class="detail"><view class="eyebrow">当前知识库</view><text style="font-size:38rpx;font-weight:600">{{selected.icon}} {{selected.name}}</text><text class="muted" style="display:block;margin-top:8rpx">{{selected.description || '暂无描述'}} · {{selected.category || '其他'}}</text><view class="detail-actions"><button class="button ghost" bindtap="upload" disabled="{{uploading}}">{{uploading ? '上传中…' : '上传资料'}}</button><button class="button primary" bindtap="chat">问 AI</button></view><view class="detail-actions"><button class="button ghost" bindtap="createPlan">生成计划</button><button class="button ghost" bindtap="generateQuiz">生成测验</button></view><view class="detail-actions"><button class="button ghost" bindtap="openEdit">编辑</button><button class="button ghost" bindtap="toggleArchive">{{selected.status == 'ARCHIVED' ? '恢复' : '归档'}}</button><button class="button ghost danger" bindtap="deleteKnowledgeBase">删除</button></view><view wx:if="{{detailError}}" class="empty"><text>{{detailError}}</text><button class="button ghost" bindtap="retryDocuments">重新加载文档</button></view><block wx:else><view class="section-head"><text style="font-weight:600">文档（{{documents.length}}）</text><text class="muted">自动刷新状态</text></view><view wx:for="{{documents}}" wx:key="id" class="doc-row"><text>文档</text><view class="main"><text>{{item.filename}}</text><text class="muted">{{item.size_bytes}} bytes · {{item.status}}</text></view><button wx:if="{{item.status == 'FAILED' || item.status == 'READY'}}" class="link" data-id="{{item.id}}" bindtap="retryDocument">{{item.status == 'READY' ? '重建' : '重试'}}</button><button class="link danger" data-id="{{item.id}}" bindtap="deleteDocument">删除</button></view><view wx:if="{{!documents.length}}" class="empty">上传 PDF、DOCX、PPTX、TXT 或 MD 文件</view></block></view>
  <view wx:if="{{modal}}" class="modal-mask"><view class="modal"><text style="font-size:36rpx;font-weight:600">{{editing ? '编辑知识库' : '新建知识库'}}</text><input placeholder="名称，例如：计算机网络" maxlength="50" value="{{form.name}}" data-field="name" bindinput="inputForm" /><textarea placeholder="描述（可选）" maxlength="500" value="{{form.description}}" data-field="description" bindinput="inputForm" /><input placeholder="图标，例如：📘" maxlength="4" value="{{form.icon}}" data-field="icon" bindinput="inputForm" /><picker range="{{categories}}" bindchange="chooseCategory"><view class="card" style="margin:0 0 18rpx"><text>分类：{{form.category}}</text><text class="arrow">›</text></view></picker><button class="button primary" style="width:100%" bindtap="saveKnowledgeBase">{{editing ? '保存修改' : '创建知识库'}}</button><button class="button ghost" style="width:100%;margin-top:14rpx" bindtap="closeCreate">取消</button></view></view>
</view>
