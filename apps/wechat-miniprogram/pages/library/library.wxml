<view class="page">
  <view class="section-head" style="margin-top:0"><view><view class="eyebrow">YOUR MATERIALS</view><text style="font-size:56rpx;font-weight:600">知识库</text></view><button class="button primary" bindtap="openCreate">＋ 新建</button></view>
  <view wx:if="{{loading}}" class="empty">正在加载知识库…</view><view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="button primary" bindtap="retry">重新加载</button></view>
  <view wx:else><view wx:for="{{libraries}}" wx:key="id" class="card" data-kb="{{item}}" bindtap="select"><view class="icon-box">{{item.icon}}</view><view class="card-main"><text style="font-weight:600">{{item.name}}</text><text class="muted">{{item.document_count}} 份资料 · {{item.chunk_count}} 个片段</text></view><text class="arrow">›</text></view><view wx:if="{{!libraries.length}}" class="empty"><text>还没有知识库</text><button class="button primary" bindtap="openCreate">创建第一个知识库</button></view></view>
  <view wx:if="{{selected}}" class="detail"><view class="eyebrow">当前知识库</view><text style="font-size:38rpx;font-weight:600">{{selected.icon}} {{selected.name}}</text><view class="detail-actions"><button class="button ghost" bindtap="upload">{{uploading ? '处理中…' : '上传资料'}}</button><button class="button primary" bindtap="chat">问 AI</button></view><view class="section-head"><text style="font-weight:600">文档（{{documents.length}}）</text><text class="muted">已按用户隔离</text></view><view wx:for="{{documents}}" wx:key="id" class="doc-row"><text>▤</text><view class="main"><text>{{item.filename}}</text><text class="muted">{{item.size_bytes}} bytes</text></view><text class="status">{{item.status}}</text></view><view wx:if="{{!documents.length}}" class="empty">上传 PDF、DOCX、PPTX、TXT 或 MD 文件</view></view>
  <view wx:if="{{modal}}" class="modal-mask"><view class="modal"><text style="font-size:36rpx;font-weight:600">新建知识库</text><input placeholder="例如：计算机网络" maxlength="50" value="{{name}}" bindinput="inputName" /><button class="button primary" style="width:100%" bindtap="create">创建知识库</button><button class="button ghost" style="width:100%;margin-top:14rpx" bindtap="closeCreate">取消</button></view></view>
</view>
