.profile-head { display:flex; align-items:center; gap:22rpx; margin:20rpx 0 44rpx; }
.avatar { background:#111318; color:#fff; }
.settings { padding:0; overflow:hidden; }
.setting-row { width:100%; border:0; border-bottom:1rpx solid #f0f1f4; border-radius:0; margin:0; text-align:left; box-sizing:border-box; }
.logout { color:#d94b5a; }
.body-copy { display:block; color:#626978; line-height:1.7; margin-top:20rpx; font-size:25rpx; }
