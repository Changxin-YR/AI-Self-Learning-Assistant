<view class="page"><view class="section-head" style="margin-top:0"><view><view class="eyebrow">KEEP YOUR PACE</view><text style="font-size:56rpx;font-weight:600">学习计划</text></view><button class="button primary" bindtap="openPlan">＋ 新计划</button></view><view wx:if="{{loading}}" class="empty">正在加载学习计划…</view><view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="button primary" bindtap="retry">重新加载</button></view><view wx:else><view wx:if="{{plan}}" class="plan"><view class="eyebrow" style="color:#a4a7b4">当前计划 · {{plan.status == 'ACTIVE' ? '进行中' : '待确认'}}</view><text style="font-size:36rpx;font-weight:600;display:block">{{plan.name}}</text><text class="muted">每天 {{plan.daily_minutes}} 分钟 · 目标 {{plan.target_date}}</text></view><view wx:else class="empty"><text>还没有学习计划</text><button class="button primary" bindtap="openPlan">生成计划</button></view><button class="button ghost" style="width:100%;margin-bottom:28rpx" bindtap="generateQuiz">生成今日测验</button><view class="section-head"><text style="font-size:32rpx;font-weight:600">今日任务</text><text class="muted">{{tasks.length}} 项</text></view><view wx:if="{{tasks.length}}"><view wx:for="{{tasks}}" wx:key="id" class="task-row {{item.status == 'DONE' ? 'done' : ''}}" data-id="{{item.id}}" bindtap="complete"><view class="check">✓</view><view class="main"><text>{{item.title}}</text><text class="muted">{{item.task_type}} · {{item.estimated_minutes}} 分钟</text></view><text class="arrow">›</text></view></view><view wx:else class="empty"><text>还没有任务，先生成一份计划</text><button class="button primary" bindtap="openPlan">生成计划</button></view></view><view wx:if="{{modal}}" class="modal-mask"><view class="modal"><text style="font-size:36rpx;font-weight:600">生成学习计划</text><text class="muted" style="display:block;margin:18rpx 0">AI 会根据知识库生成草案，确认后才会创建任务。</text><picker range="{{libraries}}" range-key="name" bindchange="chooseKb"><view class="card" style="margin:0"><text>{{selectedKb ? selectedKb.name : '选择知识库'}}</text><text class="arrow">›</text></view></picker><button class="button primary" style="width:100%;margin-top:20rpx" bindtap="createPlan">生成并开始</button><button class="button ghost" style="width:100%;margin-top:14rpx" bindtap="closePlan">取消</button></view></view></view>
