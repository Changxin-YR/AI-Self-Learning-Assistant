<view class="page"><view class="section-head" style="margin-top:0"><view><view class="eyebrow">学习节奏</view><text style="font-size:56rpx;font-weight:600">学习计划</text></view><button class="button primary" bindtap="openPlan">新建计划</button></view><view wx:if="{{loading}}" class="empty">正在加载学习计划…</view><view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="button primary" bindtap="retry">重新加载</button></view><view wx:else><view wx:if="{{plan}}" class="plan"><view class="eyebrow" style="color:#b4b8c5">当前计划 · {{plan.status == 'ACTIVE' ? '进行中' : '待确认'}}</view><text style="font-size:36rpx;font-weight:600;display:block">{{plan.name}}</text><text class="muted">每天 {{plan.daily_minutes }} 分钟 · 目标 {{plan.target_date}}</text><text class="ai-label">AI 生成 · 请核验重要信息</text></view><view wx:else class="empty"><text>还没有学习计划</text><button class="button primary" bindtap="openPlan">生成计划</button></view><button class="button ghost" style="width:100%;margin-bottom:28rpx" bindtap="generateQuiz">生成今日测验</button><view class="section-head"><text style="font-size:32rpx;font-weight:600">今日任务</text><text class="muted">{{tasks.length}} 项</text></view><view wx:if="{{tasks.length}}"><view wx:for="{{tasks}}" wx:key="id" class="task-row {{item.status == 'DONE' ? 'done' : ''}}" data-id="{{item.id}}" bindtap="complete"><view class="check">✓</view><view class="main"><text>{{item.title}}</text><text class="muted">{{item.scheduled_date}} · {{item.estimated_minutes}} 分钟</text></view><text class="arrow">›</text></view></view><view wx:else class="empty"><text>今天没有安排任务</text><button class="button primary" bindtap="openPlan">生成计划</button></view></view><view wx:if="{{modal}}" class="modal-mask"><view class="modal"><text style="font-size:36rpx;font-weight:600">{{draft ? '确认学习计划' : '生成学习计划'}}</text><text class="muted" style="display:block;margin:18rpx 0">AI 会根据知识库生成草案，确认后才会创建任务。</text><view wx:if="{{!draft}}"><input placeholder="计划名称" value="{{form.name}}" data-field="name" bindinput="input" /><textarea placeholder="学习目标" value="{{form.goal}}" data-field="goal" bindinput="input" /><input type="date" value="{{form.target_date}}" data-field="target_date" bindinput="input" /><input type="number" value="{{form.daily_minutes}}" data-field="daily_minutes" bindinput="input" /><input type="number" value="{{form.weekly_days}}" data-field="weekly_days" bindinput="input" /><picker range="{{libraries}}" range-key="name" bindchange="chooseKb"><view class="card" style="margin:0"><text>{{selectedKb ? selectedKb.name : '选择知识库'}}</text><text class="arrow">›</text></view></picker></view><view wx:else class="detail" style="margin-top:20rpx"><text style="font-weight:600">{{draft.name}}</text><text class="muted" style="display:block;margin-top:8rpx">{{draft.target_date}} · 每天 {{draft.daily_minutes}} 分钟</text></view><button wx:if="{{draft}}" class="button primary" style="width:100%;margin-top:20rpx" bindtap="confirmPlan">确认并开始</button><button wx:else class="button primary" style="width:100%;margin-top:20rpx" bindtap="createPlan">生成草案</button><button class="button ghost" style="width:100%;margin-top:14rpx" bindtap="closePlan">取消</button></view></view></view>
