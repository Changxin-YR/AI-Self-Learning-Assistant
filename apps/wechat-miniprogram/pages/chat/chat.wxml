<view class="page chat-page"><view class="section-head" style="margin-top:0"><view><view class="eyebrow">AI 学习助手</view><text style="font-size:40rpx;font-weight:600">{{name}}</text></view></view><scroll-view scroll-y class="messages"><view wx:if="{{!messages.length}}" class="empty"><text>问问你的资料，我会标注答案来源。</text></view><view wx:for="{{messages}}" wx:key="index" class="message {{item.role == 'USER' ? 'user' : 'assistant'}}"><view class="bubble">{{item.content}}</view><view wx:if="{{item.citation}}" class="citation">来源片段：{{item.citation}}</view></view><view wx:if="{{sending}}" class="muted">正在检索资料…</view></scroll-view><view class="chat-input"><input value="{{input}}" placeholder="问一个关于资料的问题…" bindinput="input" confirm-type="send" bindconfirm="send" /><button class="button primary" bindtap="send" disabled="{{sending}}">发送</button></view></view>
