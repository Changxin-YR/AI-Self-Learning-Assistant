<view class="page chat-page"><view class="section-head" style="margin-top:0"><view><view class="eyebrow">AI 学习助手</view><text style="font-size:40rpx;font-weight:600">{{name}}</text></view><button class="button ghost history-button" bindtap="openHistory">历史会话</button></view><scroll-view scroll-y class="messages" scroll-top="{{scrollTop}}"><view wx:if="{{error}}" class="empty"><text>{{error}}</text><button class="button ghost" bindtap="retry">重新加载</button></view><view wx:elif="{{!messages.length}}" class="empty"><text>从你的资料开始提问。</text></view><view wx:for="{{messages}}" wx:key="index" class="message {{item.role == 'USER' ? 'user' : 'assistant'}}"><view wx:if="{{item.role == 'ASSISTANT'}}" class="ai-label">AI 生成 · 请核验重要信息</view><view class="bubble">{{item.content}}</view><view wx:for="{{item.citations}}" wx:for-item="citation" wx:key="chunk_id" class="citation"><text>{{citation.document_name || '资料来源'}} · 第 {{citation.page_start || 1}} 页</text><text>{{citation.quote_text}}</text></view></view><view wx:if="{{sending}}" class="muted generating">正在检索并生成回答…</view></scroll-view><view class="chat-input"><input value="{{input}}" placeholder="问一个关于资料的问题…" bindinput="input" confirm-type="send" bindconfirm="send" /><button class="button primary" bindtap="send" disabled="{{sending}}">发送</button></view><view wx:if="{{historyVisible}}" class="modal-mask"><view class="modal history-modal"><view class="section-head"><text style="font-size:34rpx;font-weight:600">历史会话</text><button class="button ghost" bindtap="closeHistory">关闭</button></view><view wx:for="{{conversations}}" wx:key="id" class="history-row" data-item="{{item}}" bindtap="switchConversation"><text>{{item.title || '新会话'}}</text><button class="link danger" data-id="{{item.id}}" catchtap="deleteConversation">删除</button></view><view wx:if="{{!conversations.length}}" class="empty">暂无历史会话</view><button class="button primary" style="width:100%;margin-top:20rpx" bindtap="newConversation">新建会话</button></view></view></view>
