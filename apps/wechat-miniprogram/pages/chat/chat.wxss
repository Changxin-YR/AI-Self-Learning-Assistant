.chat-page { min-height:100vh; box-sizing:border-box; display:flex; flex-direction:column; } .messages { flex:1; min-height:760rpx; padding:20rpx 0 140rpx; } .message { display:flex; flex-direction:column; gap:8rpx; max-width:88%; margin-bottom:20rpx; } .message.user { margin-left:auto; align-items:flex-end; } .ai-label { color:#7d8290; font-size:20rpx; line-height:1.4; } .bubble { background:#fff; border:1rpx solid #e8eaf0; padding:18rpx 22rpx; border-radius:20rpx; font-size:26rpx; line-height:1.55; } .message.user .bubble { color:#fff; background:#5B5FF6; border-bottom-right-radius:6rpx; } .citation { color:#4f55ce; background:#f0f1ff; font-size:21rpx; padding:12rpx 14rpx; border-radius:12rpx; } .citation text { display:block; line-height:1.5; } .generating { padding:16rpx 0; } .chat-input { position:fixed; bottom:0; left:0; right:0; display:flex; gap:12rpx; padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background:#fff; border-top:1rpx solid #e5e7ed; } .chat-input input { flex:1; border:1rpx solid #e5e7ed; border-radius:16rpx; padding:18rpx; font-size:25rpx; } .history-button { width:auto; padding:0 20rpx; } .history-modal { max-height:78vh; overflow:auto; } .history-row { display:flex; align-items:center; justify-content:space-between; padding:20rpx 0; border-bottom:1rpx solid #edf0f5; } .history-row text { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
