.chat-page { min-height:100vh; box-sizing:border-box; display:flex; flex-direction:column; } .messages { flex:1; min-height:760rpx; padding:20rpx 0 140rpx; } .message { display:flex; flex-direction:column; gap:8rpx; max-width:88%; margin-bottom:20rpx; } .message.user { margin-left:auto; align-items:flex-end; } .bubble { background:#eef0f3; padding:18rpx 22rpx; border-radius:18rpx; font-size:26rpx; line-height:1.55; } .message.user .bubble { color:#fff; background:#5b6cff; border-bottom-right-radius:4rpx; } .citation { color:#6972d4; background:#f1f2ff; font-size:21rpx; padding:10rpx 14rpx; border-radius:10rpx; } .chat-input { position:fixed; bottom:0; left:0; right:0; display:flex; gap:12rpx; padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background:#fff; border-top:1rpx solid #e5e7ed; } .chat-input input { flex:1; border:1rpx solid #e5e7ed; border-radius:14rpx; padding:18rpx; font-size:25rpx; }
