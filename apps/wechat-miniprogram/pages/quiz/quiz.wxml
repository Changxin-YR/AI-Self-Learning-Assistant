<view class="page"><view wx:if="{{loading}}" class="empty">正在生成测验…</view><view wx:elif="{{submitted}}" class="empty"><text style="font-size:48rpx;font-weight:600;color:#171717;display:block">{{result.score}} 分</text><text>正确率 {{result.correct_rate}}%，错题已加入复习列表。</text><button class="button primary" bindtap="back">返回学习</button></view><view wx:else><view class="eyebrow">TODAY'S QUIZ</view><text style="font-size:52rpx;font-weight:600;display:block;margin-bottom:30rpx">{{quiz.title}}</text><view wx:for="{{quiz.questions}}" wx:for-item="questionItem" wx:for-index="questionIndex" wx:key="id" class="detail question"><text style="font-weight:600;display:block;line-height:1.5">{{questionIndex + 1}}. {{questionItem.question}}</text><view wx:for="{{questionItem.optionItems}}" wx:for-item="optionItem" wx:key="value" class="option {{optionItem.selected ? 'selected' : ''}}" data-id="{{questionItem.id}}" data-type="{{questionItem.question_type}}" data-value="{{optionItem.value}}" bindtap="choose"><text>{{optionItem.label}}</text></view></view><button class="button primary" style="width:100%;margin-top:28rpx" bindtap="submit">提交答案</button></view></view>
