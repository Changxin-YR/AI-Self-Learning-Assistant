<view class="page"><view wx:if="{{loading}}" class="empty">正在生成测验…</view><view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="button ghost" bindtap="back">返回</button></view><view wx:elif="{{submitted}}"><view class="result-card"><view class="eyebrow">测验结果</view><text class="result-score">{{result.score}} / {{result.max_score}}</text><text class="muted">正确率 {{result.correct_rate}}%</text><text class="ai-label">AI 生成 · 请核验重要信息</text></view><view wx:for="{{result.quiz.questions}}" wx:key="id" class="detail question"><text style="font-weight:600;display:block;line-height:1.5">{{index + 1}}. {{item.question}}</text><text class="answer">你的答案：{{item.user_answer.length ? item.user_answer : '未作答'}}</text><text class="answer">正确答案：{{item.correct_answer}}</text><text class="muted" style="display:block;margin-top:8rpx">解析：{{item.explanation}}</text><text wx:if="{{item.ai_feedback}}" class="muted" style="display:block;margin-top:8rpx">评分说明：{{item.ai_feedback}}</text><text wx:if="{{item.evidence}}" class="citation">资料证据：{{item.evidence}}</text></view><button class="button primary" style="width:100%;margin-top:28rpx" bindtap="back">返回学习</button></view><view wx:else><view class="eyebrow">今日测验</view><text style="font-size:52rpx;font-weight:600;display:block;margin-bottom:30rpx">{{quiz.title}}</text><text class="ai-label">AI 生成 · 请核验重要信息</text><view wx:for="{{quiz.questions}}" wx:for-item="questionItem" wx:for-index="questionIndex" wx:key="id" class="detail question"><text style="font-weight:600;display:block;line-height:1.5">{{questionIndex + 1}}. {{questionItem.question}}</text><view wx:if="{{questionItem.question_type != 'SHORT'}}"><view wx:for="{{questionItem.optionItems}}" wx:for-item="optionItem" wx:key="value" class="option {{optionItem.selected ? 'selected' : ''}}" data-id="{{questionItem.id}}" data-type="{{questionItem.question_type}}" data-value="{{optionItem.value}}" bindtap="choose"><text>{{optionItem.value}} · {{optionItem.label}}</text></view></view><textarea wx:else placeholder="写下你的答案" data-id="{{questionItem.id}}" bindinput="inputShort" /></view><button class="button primary" style="width:100%;margin-top:28rpx" bindtap="submit">提交答案</button></view></view>
