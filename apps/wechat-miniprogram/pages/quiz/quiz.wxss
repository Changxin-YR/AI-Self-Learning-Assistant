.question { margin-bottom:20rpx; } .option { padding:20rpx; border:1rpx solid #e5e7ed; border-radius:16rpx; margin-top:12rpx; font-size:25rpx; } .option.selected { color:#5B5FF6; border-color:#5B5FF6; background:#f1f2ff; } .question textarea { width:100%; min-height:160rpx; box-sizing:border-box; margin-top:16rpx; padding:18rpx; border:1rpx solid #e5e7ed; border-radius:16rpx; } .result-card { background:#111318; color:#fff; border-radius:32rpx; padding:32rpx; margin-bottom:24rpx; } .result-score { display:block; font-size:64rpx; font-weight:600; margin:10rpx 0; } .result-card .muted { color:#b4b8c5; } .answer,.citation { display:block; margin-top:12rpx; font-size:22rpx; color:#4f55ce; background:#f0f1ff; padding:10rpx 14rpx; border-radius:10rpx; }
