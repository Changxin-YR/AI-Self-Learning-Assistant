<view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载你的学习空间…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="button primary" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="eyebrow">STUDYAGENT</view><view class="welcome"><text class="greeting">你好，{{nickname}}</text><text class="muted">今天也保持好奇心。</text></view>
    <view class="focus-card"><view class="focus-line"><view><view class="eyebrow" style="color:#b4b8c5">今日学习</view><text style="font-size:38rpx;font-weight:600">{{dashboard.task_done || 0}} / {{dashboard.task_total || 0}} 项任务</text></view><text style="font-size:34rpx">{{progress}}%</text></view><view class="progress"><view style="width:{{progress}}%"></view></view><view class="focus-line"><text class="muted" style="color:#b4b8c5">已学习 {{dashboard.today_minutes || 0}} 分钟</text><button class="button" style="background:#fff" bindtap="goLearning">继续学习</button></view></view>
    <view class="section-head"><text style="font-size:32rpx;font-weight:600">AI 快捷入口</text><text class="muted">一键开始</text></view>
    <view class="quick-grid"><button class="quick" bindtap="openChat"><text class="icon">问</text><text>问知识库</text><text class="muted">从资料中找答案</text></button><button class="quick" data-action="summary" bindtap="openChat"><text class="icon">览</text><text>总结资料</text><text class="muted">提炼核心内容</text></button><button class="quick" bindtap="createPlan"><text class="icon">计</text><text>制定计划</text><text class="muted">按目标安排学习</text></button><button class="quick" bindtap="generateQuiz"><text class="icon">测</text><text>生成测试</text><text class="muted">检验掌握程度</text></button></view>
    <view class="section-head"><text style="font-size:32rpx;font-weight:600">最近知识库</text><button class="link" bindtap="goLibrary">查看全部 ›</button></view>
    <view wx:if="{{libraries.length}}"><view wx:for="{{libraries}}" wx:key="id" class="card" data-kb="{{item}}" bindtap="openChat"><view class="icon-box">{{item.icon}}</view><view class="card-main"><text style="font-weight:600">{{item.name}}</text><text class="muted">{{item.document_count}} 份资料 · {{item.chunk_count}} 个片段</text></view><text class="arrow">›</text></view></view>
    <view wx:else class="empty"><text>创建第一个知识库，开始沉淀学习资料</text><button class="button primary" bindtap="goLibrary">新建知识库</button></view>
  </block>
</view>
